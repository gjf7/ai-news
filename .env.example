# Server
NODE_ENV=development
PORT=3000
DATABASE_PATH=./data/app.db
# Optional: where daily snapshots are written. Defaults to <database dir>/backups.
# BACKUP_DIR=/data/backups

# Auth — generate the hash with:
#   vp run server#hash-password -- 'your-password'
SESSION_SECRET=replace-with-32-plus-random-characters
LOGIN_PASSWORD_HASH=
SESSION_TTL_HOURS=720

# Refresh schedule
REFRESH_INTERVAL_MINUTES=30

# Per-run limits (tunable product parameters; see docs/architecture.md).
# Measured against live sources: an initial burst is ~600 events and a run
# works through it over several intervals by design.
RUN_TIMEOUT_MINUTES=20
ANALYZE_MAX_EVENTS=40
FILTER_MAX_BATCHES=8
CLUSTER_MAX_BATCHES=4

# Telegram notifications
NOTIFY_ENABLED=true
NOTIFY_MAX_ITEMS=5
NOTIFY_MIN_IMPORTANCE=70
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Model (OpenAI-compatible; defaults to DeepSeek)
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
MODEL_NAME=deepseek-chat
